# ─── SUPABASE CONFIGURATION (DATABASE & AUTH) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ─── DEMO ACCOUNTS (seeded in Supabase Auth — shown on the login forms) ───
# admin@keralakitchen.com   / admin@7736     (Restaurant Admin)
# staff@keralakitchen.com   / staff@7736     (Kitchen Staff)
# driver@keralakitchen.com  / driver@7736    (Delivery Driver)
# customer@keralakitchen.com / customer@123  (Onam Customer)

# ─── EMAIL CONFIGURATION (Resend HTTP API — Cloudflare Workers compatible) ───
# Get a free API key at https://resend.com and verify a sender domain.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Kerala Kitchen <bookings@your-domain.com>
ADMIN_NOTIFICATION_EMAIL=admin-keralakitchen@example.com
